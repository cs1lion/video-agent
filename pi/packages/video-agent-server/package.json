{
	"name": "@earendil-works/pi-video-agent-server",
	"version": "0.0.1",
	"private": true,
	"description": "Colocated Express server for the video ad agent UI: interview sessions + real generation pipeline",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
