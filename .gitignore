# dependencies / build artifacts
node_modules/
dist/
*.tsbuildinfo

# 本地运行数据：run 产物、上传素材、成片与日志（含隐私，不入库）
.pi-studio/

# pi 上游仓库的原始 git 历史（整库迁移备份，不入工作树版本）
.vendored-git-history/

# 媒体工具二进制（ffmpeg 解压目录 + 106MB 的 ffmpeg.zip，均不入版本库）
tools/

# e2e 实验产物：results/ 是每轮跑批的成片与中间态（1.4G，无版本价值）。
# e2e/*.mjs、lib/、README.md、迭代日志是有价值的工具脚本，保留入库。
e2e/results/

# 日志与临时文件
*.log
*.tmp/
*.tmp
Thumbs.db
.DS_Store
# 密钥/凭据：绝不能入库（工具模型.txt 内含 StepFun / Agnes 明文 API key）
工具模型.txt
*.key
.env
.env.*

# 本地实验产物：TTS/视频试跑的音视频文件（体积大、无版本价值）
_tts_test/
*.wav
*.mp3
*.mp4

# 会话导出与设计/验证报告（一次性产物，不入代码库）
pi-session-*.html

# 部署密钥：构建前从 .pi-studio/models.json 拷入，严禁提交
pi/deploy/models.json

# 部署打包产物：tar.gz 内已包含 deploy/models.json（明文 provider key），
# 一旦 add 就等于把密钥再次写进提交历史。2026-09-04 部署 CVM 时引入，务必保留此规则。
# 需要重新部署时用 pi/deploy/deploy-to-cvm.sh 现打现传，不要把包留在仓库。
*.tar.gz
